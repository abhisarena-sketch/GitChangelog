# Git ChangeLog reads these from the environment of the shell (or Git client) that runs `git commit`.
# Alternatively, `git-changelog init` / `git-changelog config` can store keys in .changelog/secrets.yml.

# AI provider: anthropic | openai | none (overrides ai.provider in .changelogrc.yml)
CHANGELOG_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Notion destination
NOTION_TOKEN=

# Set to 1 to skip the hook for a single command
# GIT_CHANGELOG_SKIP=1
